{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    // proxy/function.ts imports the SDK by its Bun version-pinned specifier.
    "paths": { "@anthropic-ai/sdk@0.135.0": ["./node_modules/@anthropic-ai/sdk"] }
  },
  "include": ["src", "test", "tools", "proxy", "vite.config.ts"]
}
